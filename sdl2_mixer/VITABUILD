pkgname=sdl2_mixer
pkgver=2.6.2
pkgrel=1
url="https://www.libsdl.org/projects/SDL_mixer/"
source=(
    "https://github.com/libsdl-org/SDL_mixer/releases/download/release-${pkgver}/SDL2_mixer-${pkgver}.tar.gz"
    timidity.patch
    pkgconfig_install.patch
)
sha256sums=(
    8cdea810366decba3c33d32b8071bccd1c309b2499a54946d92b48e6922aa371
    12ed0e1e20c9c7cf0c4075a5f17f3bb1c529774d56faa15e157c1030ffe8a357
    e5809c4caf6f07481dd5bc681246071e3870fcdd3f87378a5797b0a232acf965
)

depends=('sdl2' 'libvorbis' 'libmikmod' 'libmodplug')

prepare() {
  cd "SDL2_mixer-${pkgver}"
  patch --strip=1 --input="${srcdir}/timidity.patch"
  patch --strip=1 --input="${srcdir}/pkgconfig_install.patch"
}

build() {
  cd "SDL2_mixer-${pkgver}"
  mkdir build && cd build
  cmake .. -DCMAKE_TOOLCHAIN_FILE=$VITASDK/share/vita.toolchain.cmake -DCMAKE_BUILD_TYPE=Release \
           -DBUILD_SHARED_LIBS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=OFF \
           -DSDL2MIXER_DEPS_SHARED=OFF -DSDL2MIXER_SAMPLES=OFF \
           -DSDL2MIXER_MIDI_TIMIDITY=ON -DSDL2MIXER_MIDI_FLUIDSYNTH=OFF \
           -DSDL2MIXER_OPUS=OFF \
           -DSDL2MIXER_FLAC_LIBFLAC=OFF \
           -DCMAKE_INSTALL_PREFIX=$prefix
  make -j$(nproc)
}

package () {
  cd "SDL2_mixer-${pkgver}/build"
  make DESTDIR=$pkgdir install
}

